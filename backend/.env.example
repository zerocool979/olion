# Local development only. Never commit real credentials or production secrets.
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/olion?schema=public"
# Optional pooled URL for Vercel Prisma Postgres application traffic.
# Prisma CLI migrations continue to use DATABASE_URL (direct connection).
DATABASE_URL_POOLED=

# Generate a unique random value for your local environment.
JWT_SECRET=replace-with-a-long-random-secret

# SMTP email delivery (required before enabling email verification in production)
FRONTEND_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OLION <no-reply@example.com>

# Browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Google Identity Services (optional)
GOOGLE_CLIENT_ID=

# LIA providers (optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Chat attachment storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WebRTC TURN server (optional)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
